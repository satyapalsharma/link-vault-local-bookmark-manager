# Auto-detect text files and ensure consistent line endings
* text=auto

# Source files - use LF line endings
*.ts text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Binary files - do not diff
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary

# Linguist hints
*.ts linguist-language=TypeScript
*.js linguist-language=JavaScript
*.json linguist-language=JSON
*.md linguist-documentation
*.yml linguist-language=YAML
*.yaml linguist-language=YAML
